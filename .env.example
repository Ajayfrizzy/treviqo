# Copy to .env. Blank integrations remain unavailable; never put secrets in NEXT_PUBLIC_*.
APP_URL=http://localhost:3000
# Same canonical URL as APP_URL; required by NextAuth.
NEXTAUTH_URL=http://localhost:3000
SESSION_SECRET=
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set false only if the Rumpty endpoint supports virtual-hosted bucket addressing.
S3_FORCE_PATH_STYLE=true
# Optional: required only when starting local services with docker compose.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# PDF/JPEG/PNG limit in MiB (1–20). Default balances phone uploads and server memory.
DOCUMENT_MAX_FILE_MB=10

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  // Preserve legacy identities without requiring an external provider.
  issuer            String?
  subject           String?
  email             String?              @unique
  passwordHash      String?
  deletionStartedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  sessions          AuthSession[]
  employments       Employment[]
  documents         EmploymentDocument[]
  auditEvents       AuditEvent[]
  exitCases         ExitCase[]

  @@unique([issuer, subject])
}

model AuthSession {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum EmploymentStatus {
  active
  exiting
  closed
}

enum EmploymentType {
  permanent
  contract
  temporary
  internship
  other
}

model Employment {
  id             String               @id @default(cuid())
  userId         String
  employerName   String               @db.VarChar(160)
  roleTitle      String               @db.VarChar(160)
  startDate      DateTime             @db.Date
  endDate        DateTime?            @db.Date
  employmentType EmploymentType?
  status         EmploymentStatus     @default(active)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents      EmploymentDocument[]
  exitCases      ExitCase[]
  benefits       Benefit[]

  @@unique([id, userId])
  @@index([userId, status, startDate])
}

enum DocumentType {
  employment_contract
  payslip
  resignation_letter
  termination_letter
  exit_letter
  pension_statement
  final_settlement
  reimbursement_evidence
  benefit_document
  other
}

enum DocumentStatus {
  uploaded
  processing
  ready
  failed
  deleting
  deleted
}

enum AuditAction {
  document_uploaded
  document_access_issued
  document_deleted
  extraction_started
  extraction_completed
  extraction_failed
  extraction_reviewed
  exit_created
  exit_updated
  settlement_saved
  settlement_removed
  pension_started
  pension_updated
  pension_confirmed
  benefit_saved
  benefit_removed
  employment_created
  employment_updated
  employment_closed
  reminder_created
  reminder_changed
  reminder_resolved
  reminder_snoozed
  reminder_dismissed
}

model EmploymentDocument {
  id                String               @id @default(uuid())
  userId            String
  employmentId      String
  documentType      DocumentType         @default(other)
  originalFilename  String               @db.VarChar(255)
  sanitizedFilename String               @db.VarChar(160)
  objectKey         String               @unique
  mimeType          String               @db.VarChar(64)
  fileSize          Int
  checksum          String               @db.VarChar(64)
  storagePurgedAt   DateTime?
  status            DocumentStatus       @default(uploaded)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  employment        Employment           @relation(fields: [employmentId, userId], references: [id, userId], onDelete: Restrict)
  extractions       DocumentExtraction[]

  @@unique([id, userId])
  @@index([userId, employmentId, createdAt])
  @@index([status, updatedAt])
}

model AuditEvent {
  id           String      @id @default(cuid())
  userId       String
  documentId   String?
  exitCaseId   String?
  reminderId   String?
  benefitId    String?
  employmentId String
  action       AuditAction
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([documentId, action])
}

enum ExtractionStatus {
  processing
  ready
  failed
}

enum ExtractionConfidence {
  high
  medium
  low
  needs_review
}

enum FieldReviewState {
  proposed
  confirmed
  corrected
  rejected
  unknown
}

model DocumentExtraction {
  id            String             @id @default(uuid())
  documentId    String
  userId        String
  status        ExtractionStatus   @default(processing)
  documentType  DocumentType?
  sourceKind    String             @db.VarChar(32)
  sourceHash    String?            @db.VarChar(64)
  model         String             @db.VarChar(160)
  promptVersion String             @db.VarChar(64)
  schemaVersion String             @db.VarChar(64)
  errorCode     String?            @db.VarChar(32)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  document      EmploymentDocument @relation(fields: [documentId, userId], references: [id, userId], onDelete: Cascade)
  fields        ExtractedField[]

  @@index([userId, documentId, createdAt])
  @@index([status, createdAt])
}

model ExtractedField {
  id            String                    @id @default(uuid())
  extractionId  String
  key           String                    @db.VarChar(64)
  proposedValue String?                   @db.VarChar(1000)
  value         String?                   @db.VarChar(1000)
  evidence      String?                   @db.VarChar(1600)
  confidence    ExtractionConfidence
  reviewState   FieldReviewState          @default(proposed)
  version       Int                       @default(0)
  updatedAt     DateTime                  @updatedAt
  extraction    DocumentExtraction        @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  revisions     ExtractionFieldRevision[]

  @@unique([extractionId, key])
}

model ExtractionFieldRevision {
  id        String           @id @default(uuid())
  fieldId   String
  state     FieldReviewState
  value     String?          @db.VarChar(1000)
  createdAt DateTime         @default(now())
  field     ExtractedField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, createdAt])
}

enum ExitType {
  resignation
  termination
  redundancy
  contract_completion
  retirement
}

enum ExitAnswer {
  unknown
  yes
  no
}

enum ExitFollowup {
  unknown
  none
  pending
  resolved
}

enum ExitAssets {
  unknown
  none
  held
  scheduled
  returned
}

enum ExitReference {
  unknown
  not_needed
  not_requested
  requested
  saved
}

model ExitCase {
  id                      String               @id @default(uuid())
  userId                  String
  employmentId            String               @unique
  exitType                ExitType
  lastWorkingDate         DateTime             @db.Date
  noticeDate              DateTime?            @db.Date
  noticeApplicable        ExitAnswer           @default(unknown)
  noticeRequirement       String?              @db.VarChar(1000)
  noticeFieldId           String?
  noticeFieldVersion      Int?
  finalPayDocumentId      String?
  finalPayPeriod          String?              @db.VarChar(160)
  leave                   ExitFollowup         @default(unknown)
  reimbursements          ExitFollowup         @default(unknown)
  reimbursementDocumentId String?
  pension                 ExitAnswer           @default(unknown)
  pensionDetailsSaved     Boolean              @default(false)
  assets                  ExitAssets           @default(unknown)
  assetDocumentId         String?
  exitDocumentId          String?
  reference               ExitReference        @default(unknown)
  referenceDocumentId     String?
  benefits                ExitFollowup         @default(unknown)
  version                 Int                  @default(0)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  employment              Employment           @relation(fields: [employmentId, userId], references: [id, userId], onDelete: Cascade)
  settlementItems         SettlementItem[]
  pensionVerification     PensionVerification?
  reminders               Reminder[]

  @@unique([id, userId])
  @@index([userId, updatedAt])
}

enum SettlementCategory {
  final_salary
  leave
  reimbursement
  bonus
  pension_deduction
  loan_deduction
  other_deduction
  total
}

model SettlementItem {
  id                   String             @id @default(uuid())
  exitCaseId           String
  userId               String
  category             SettlementCategory
  label                String             @db.VarChar(160)
  documentId           String
  expectedFieldId      String
  expectedFieldVersion Int
  actualFieldId        String?
  actualFieldVersion   Int?
  expectedPeriod       String             @db.VarChar(7)
  actualPeriod         String             @db.VarChar(7)
  version              Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  exitCase             ExitCase           @relation(fields: [exitCaseId, userId], references: [id, userId], onDelete: Cascade)

  @@index([exitCaseId, userId])
}

model PensionVerification {
  id                   String    @id @default(uuid())
  exitCaseId           String    @unique
  userId               String
  targetPeriod         String    @db.VarChar(7)
  statementRunId       String?
  expectedFieldId      String?
  expectedFieldVersion Int?
  followUpDate         DateTime? @db.Date
  confirmedHash        String?   @db.VarChar(64)
  confirmedAt          DateTime?
  version              Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  exitCase             ExitCase  @relation(fields: [exitCaseId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([exitCaseId, userId])
  @@index([userId, followUpDate])
}

enum BenefitCategory {
  pension
  hmo
  group_life
  employer_specific
  cooperative
  provident
}

enum BenefitPortability {
  portable
  employer_linked
  unknown
}

model Benefit {
  id                      String             @id @default(uuid())
  userId                  String
  employmentId            String
  category                BenefitCategory
  classification          BenefitPortability @default(unknown)
  sourceDocumentId        String?
  sourceDocumentUpdatedAt DateTime?
  sourceFieldId           String?
  sourceFieldVersion      Int?
  contextHash             String             @db.VarChar(64)
  version                 Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  employment              Employment         @relation(fields: [employmentId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([employmentId, category])
  @@index([userId, employmentId])
}

enum ReminderKind {
  exit_action
  pension_followup
  missing_document
  stale_action
}

enum ReminderState {
  active
  snoozed
  dismissed
  resolved
}

model Reminder {
  id           String        @id @default(uuid())
  userId       String
  exitCaseId   String
  key          String        @db.VarChar(64)
  kind         ReminderKind
  fingerprint  String        @db.VarChar(64)
  state        ReminderState @default(active)
  dueAt        DateTime
  snoozedUntil DateTime?
  version      Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  exitCase     ExitCase      @relation(fields: [exitCaseId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([exitCaseId, key])
  @@index([userId, state, dueAt])
}

model BackgroundJob {
  id              String    @id
  state           String    @default("pending") @db.VarChar(16)
  dueAt           DateTime  @default(now())
  cursor          String?
  leaseToken      String?
  leaseUntil      DateTime?
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())
  lastSucceededAt DateTime?
  errorCode       String?   @db.VarChar(32)
  updatedAt       DateTime  @updatedAt

  @@index([state, dueAt])
}

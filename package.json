{
  "name": "treviqo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run worker:build && playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build && npm run worker:build",
    "postinstall": "prisma generate",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "node --conditions=react-server dist-worker/worker/main.js",
    "worker:health": "node --conditions=react-server dist-worker/worker/health.js",
    "deployment:check": "node --conditions=react-server dist-worker/ops/deployment.js",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "ioredis": "^6.0.0",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "3.9.9",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
